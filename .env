# База данных
POSTGRES_USER=postgres_Selfhosted_CloudStorage_admin # must be chagend in prod
POSTGRES_PASSWORD=postgres_Selfhosted_CloudStorage_admin-password_must_be_changed # must be chagend in prod
POSTGRES_DB=appdb

# MinIO
MINIO_ACCESS_KEY=minio_Selfhosted_CloudStorage_admin # must be chagend in prod
MINIO_SECRET_KEY=minio_Selfhosted_CloudStorage_admin-password_must_be_changed # must be chagend in prod
S3_BUCKET=cloudstorage

# JWT — сгенерируй: openssl rand -hex 32
SECRET_KEY= # must be chagend in prod

# ─── Публичный URL для presigned ссылок (для VPS) ──────────────────────────────
# Замените на ваш домен или IP адрес сервера при развёртывании
# Примеры: http://192.0.2.1:9000  или  https://cloud.example.com
MINIO_PUBLIC_URL=http://localhost:9000
